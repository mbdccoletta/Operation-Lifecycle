{
  "name": "problems-hub",
  "version": "0.0.0",
  "description": "Central de problemas Dynatrace com visão geral, drilldown, filtros e compartilhamento",
  "license": "SEE LICENSE IN LICENSE.txt",
  "private": true,
  "scripts": {
    "start": "dt-app dev",
    "dev:devtenant": "dt-app dev --environment-url https://dev-tenant.apps.dynatrace.com",
    "deploy:devtenant": "dt-app deploy --environment-url https://dev-tenant.apps.dynatrace.com",
    "build": "dt-app build",
    "deploy": "dt-app deploy",
    "uninstall": "dt-app uninstall",
    "update": "dt-app update",
    "info": "dt-app info",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=16.13.0"
  },
  "dependencies": {
    "@dynatrace-sdk/app-environment": "^1.1.4",
    "@dynatrace-sdk/client-document": "^1.21.2",
    "@dynatrace-sdk/client-query": "^1.25.0",
    "@dynatrace-sdk/navigation": "^2.2.0",
    "@dynatrace-sdk/react-hooks": "^1.6.0",
    "@dynatrace/strato-components": "^3.5.0",
    "@dynatrace/strato-components-preview": "^3.4.0",
    "@dynatrace/strato-design-tokens": "^1.2.0",
    "@dynatrace/strato-icons": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.2"
  },
  "devDependencies": {
    "dt-app": "1.9.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@testing-library/react": "^14.3.1",
